<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"

        fx:controller="ui.MaintenanceController"

        spacing="20"
        alignment="TOP_CENTER"

        style="
            -fx-background-color: #F0F0F0;
            -fx-padding: 30;
        ">

    <HBox
            spacing="20"
            alignment="CENTER_LEFT">

        <Button
                text="Back"
                onAction="#backToMainPage"/>

        <Label
                text="Machine Maintenance"

                style="
                    -fx-font-size: 30px;
                    -fx-font-weight: bold;
                "/>

    </HBox>

    <ScrollPane

            fitToWidth="true"
            fitToHeight="true"

            pannable="true"

            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"

            VBox.vgrow="ALWAYS"

            prefHeight="500">

        <content>

            <GridPane

                    fx:id="slotGrid"

                    alignment="TOP_CENTER"

                    hgap="15"
                    vgap="15"

                    style="
                        -fx-padding:20;
                    "/>

        </content>

    </ScrollPane>

    <Label
        fx:id="addOnLabel"

        text="Add-On Slots"

        style="
            -fx-font-size:22px;
            -fx-font-weight:bold;
        "/>

<ScrollPane

        fx:id="addOnScroll"

        fitToWidth="true"
        fitToHeight="true"

        pannable="true"

        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"

        VBox.vgrow="ALWAYS"

        prefHeight="220">

    <content>

        <GridPane

                fx:id="addOnGrid"

                alignment="TOP_CENTER"

                hgap="15"
                vgap="15"

                style="
                    -fx-padding:20;
                "/>

    </content>

</ScrollPane>




    <Label
            text="Machine Maintenance"

            style="
                -fx-font-size:22px;
                -fx-font-weight:bold;
            "/>

    <Label
    fx:id="cashLabel"
    text="Cash Register: ₱0.00"
    style="-fx-font-size:18px;-fx-font-weight:bold;"/>

    <HBox

            spacing="15"

            alignment="CENTER">

        <Button
                text="Replenish Cash"
                onAction="#replenishCash"/>

                

        <Button
                text="Collect Balance"
                onAction="#collectBalance"/>

        <Button
                text="Display Summary"
                onAction="#displaySummary"/>

    </HBox>

     <HBox>
        
    <Button
    text="Save"
    
    
    style="
    -fx-background-color:#53D94F;
    -fx-text-fill:white;
    "
    onAction="#saveInventory"/>
    
    <Button
    
    text="Remove Machine"
    
    style="
    -fx-background-color:#D9534F;
    -fx-text-fill:white;
    "
    
    onAction="#removeMachine"/>
    
   </HBox>
</VBox>