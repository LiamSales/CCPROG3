<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ui.BlankPageController"

        style="-fx-background-color:#EAEAEA;">

    <!-- ================= TOP ================= -->

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding:20;">

            <Button
                    text="Back"
                    prefWidth="90"
                    onAction="#backToMainPage"/>

            <Label
                    text="Test Machine"
                    style="
                        -fx-font-size:30;
                        -fx-font-weight:bold;
                    "/>

        </HBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <HBox
                spacing="30"
                alignment="TOP_CENTER"
                style="-fx-padding:20;">

            <!-- ================================================= -->
            <!-- VENDING MACHINE                                   -->
            <!-- ================================================= -->

            <VBox
                    spacing="20"
                    prefWidth="720"

                    style="
                        -fx-background-color:#2D2D2D;
                        -fx-background-radius:20;
                        -fx-padding:20;
                    ">

                <Label
                        text="Select an Item"

                        style="
                            -fx-text-fill:white;
                            -fx-font-size:24;
                            -fx-font-weight:bold;
                        "/>

                <GridPane
                        hgap="15"
                        vgap="15">

                    <!-- SLOT A1 -->

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="0"
                          spacing="6"
                          alignment="CENTER"

                          prefWidth="150"

                          style="
                              -fx-background-color:white;
                              -fx-background-radius:10;
                              -fx-padding:10;
                          ">

                        <Pane
                                prefWidth="100"
                                prefHeight="80"
                                style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT A2 -->

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="1"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT A3 -->

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="2"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT A4 -->

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="3"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT B1 -->

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="0"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT B2 -->

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="1"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT B3 -->

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="2"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                    <!-- SLOT B4 -->

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="3"
                          spacing="6"
                          alignment="CENTER"
                          prefWidth="150"
                          style="-fx-background-color:white;-fx-background-radius:10;-fx-padding:10;">

                        <Pane prefWidth="100" prefHeight="80"
                              style="-fx-background-color:#CCCCCC;"/>

                        <Label text="Item Name"/>
                        <Label text="₱50.00"/>
                        <Label text="Qty: 10"/>

                        <Button text="Select"/>

                    </VBox>

                </GridPane>

            </VBox>

            <!-- ================================================= -->
            <!-- RIGHT PANEL                                       -->
            <!-- ================================================= -->

            <VBox

                    spacing="18"
                    prefWidth="260"

                    style="
                        -fx-background-color:white;
                        -fx-background-radius:20;
                        -fx-padding:20;
                    ">

                <Label
                        text="Current Balance"
                        style="-fx-font-size:20;-fx-font-weight:bold;"/>

                <Label
                        text="₱0.00"

                        style="
                            -fx-font-size:28;
                            -fx-font-weight:bold;
                            -fx-text-fill:#2E8B57;
                        "/>

                <Separator/>

                <Label
                        text="Insert Cash"
                        style="-fx-font-size:18;-fx-font-weight:bold;"/>

                <GridPane
                        hgap="10"
                        vgap="10">

                    <Button text="₱1" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="₱5" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Button text="₱10" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button text="₱20" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Button text="₱50" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button text="₱100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Button text="₱200" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Button text="₱500" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Button text="₱1000"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="0"
                            GridPane.columnSpan="2"
                            maxWidth="Infinity"/>

                </GridPane>

                <Separator/>

                <Label
                        text="Selected Item"
                        style="-fx-font-size:18;-fx-font-weight:bold;"/>

                <Label text="None"/>

                <Button
                        text="Purchase"
                        prefHeight="45"
                        maxWidth="Infinity"/>

                <Button
                        text="Cancel / Get Change"
                        prefHeight="45"
                        maxWidth="Infinity"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>