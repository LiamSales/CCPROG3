<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ui.TestController"

        style="-fx-background-color:#D9D9D9;">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"

                style="
                    -fx-background-color:#ECECEC;
                    -fx-padding:20;
                ">

            <Button
                    text="Back"
                    prefWidth="90"
                    onAction="#backToMainPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label
                    text="Test Vending Machine"

                    style="
                        -fx-font-size:26px;
                        -fx-font-weight:bold;
                    "/>

        </HBox>

    </top>

    <!-- ===================================================== -->
    <!-- CENTER -->
    <!-- ===================================================== -->

    <center>

        <HBox
                spacing="35"
                alignment="TOP_CENTER">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- ============================================== -->
            <!-- MACHINE BODY -->
            <!-- ============================================== -->

            <VBox

                    prefWidth="760"
                    spacing="20"

                    HBox.hgrow="ALWAYS"

                    style="
                        -fx-background-color:#2A2A2A;
                        -fx-background-radius:20;
                        -fx-border-color:#666666;
                        -fx-border-width:5;
                        -fx-border-radius:20;
                        -fx-padding:25;
                    ">

                <Label
                        text="ITEMS"

                        style="
                            -fx-text-fill:white;
                            -fx-font-size:22px;
                            -fx-font-weight:bold;
                        "/>

                <!-- KEEP THIS DYNAMIC -->

                <ScrollPane

                        fitToWidth="true"

                        fitToHeight="true"

                        VBox.vgrow="ALWAYS"

                        style="
                            -fx-background:#2A2A2A;
                            -fx-background-color:#2A2A2A;
                        ">

                    <content>

                        <GridPane

                                fx:id="slotGrid"

                                hgap="25"

                                vgap="25"

                                style="-fx-padding:10;"/>

                    </content>

                </ScrollPane>

                <Separator/>

                <Label

                        fx:id="addOnTitle"

                        text="ADD-ONS"

                        style="
                            -fx-text-fill:white;
                            -fx-font-size:20px;
                            -fx-font-weight:bold;
                        "/>

                <!-- KEEP THIS DYNAMIC -->

                <ScrollPane

                        fx:id="addOnScroll"

                        fitToHeight="true"

                        fitToWidth="true"

                        prefHeight="180"

                        style="
                            -fx-background:#2A2A2A;
                            -fx-background-color:#2A2A2A;
                        ">

                    <content>

                        <HBox

                                fx:id="addOnContainer"

                                alignment="CENTER_LEFT"

                                spacing="35"

                                style="-fx-padding:15;"/>

                    </content>

                </ScrollPane>

            </VBox>

            <!-- ============================================== -->
            <!-- PAYMENT PANEL -->
            <!-- ============================================== -->

            <VBox

                    prefWidth="285"

                    spacing="18"

                    alignment="TOP_CENTER"

                    style="
                        -fx-background-color:#F6F6F6;
                        -fx-background-radius:18;
                        -fx-border-color:#BBBBBB;
                        -fx-border-width:2;
                        -fx-border-radius:18;
                        -fx-padding:20;
                    ">

                <Label

                        text="CURRENT BALANCE"

                        style="
                            -fx-font-size:16;
                            -fx-font-weight:bold;
                        "/>

                <StackPane

                        prefHeight="70"

                        style="
                            -fx-background-color:#325C39;
                            -fx-background-radius:8;
                            -fx-border-color:#222222;
                            -fx-border-width:3;
                        ">

                    <Label

                            fx:id="balanceLabel"

                            text="₱0.00"

                            style="
                                -fx-font-family:'Consolas';
                                -fx-font-size:32;
                                -fx-font-weight:bold;
                                -fx-text-fill:#9CFF7A;
                            "/>

                </StackPane>

                <Separator/>

                <Label

                        text="INSERT CASH"

                        style="
                            -fx-font-size:18;
                            -fx-font-weight:bold;
                        "/>

                <GridPane

                        hgap="10"

                        vgap="10"

                        alignment="CENTER">
                    <Button
                            text="₱1"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱5"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱10"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱20"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱50"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱100"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱200"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱500"
                            prefWidth="95"
                            prefHeight="45"
                            onAction="#addCash"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱1000"
                            prefHeight="45"
                            maxWidth="Infinity"
                            onAction="#addCash"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="0"
                            GridPane.columnSpan="2"/>

                </GridPane>

                <Separator/>

                <Button
                        text="GET CHANGE"
                        prefHeight="55"
                        maxWidth="Infinity"
                        onAction="#getChange"

                        style="
                            -fx-background-color:#C0392B;
                            -fx-text-fill:white;
                            -fx-font-size:18;
                            -fx-font-weight:bold;
                        "/>

                <Separator/>

                <!-- DISPLAY -->

                <StackPane

                        prefHeight="60"

                        style="
                            -fx-background-color:#325C39;
                            -fx-background-radius:8;
                            -fx-border-color:#222222;
                            -fx-border-width:3;
                        ">

                    <Label

                            fx:id="displayLabel"

                            text="Welcome"

                            style="
                                -fx-font-family:'Consolas';
                                -fx-font-size:18;
                                -fx-font-weight:bold;
                                -fx-text-fill:#9CFF7A;
                            "/>

                </StackPane>

                <Separator/>

                <!-- DISPENSE / PREVIEW AREA -->

                <StackPane

                        prefHeight="150"

                        style="
                            -fx-background-color:#000000;
                            -fx-background-radius:8;
                            -fx-border-color:#222222;
                            -fx-border-width:3;
                        ">

                    <!--
                        Leave this empty unless your controller
                        displays dispensed item images.
                    -->

                </StackPane>

            </VBox>

        </HBox>

    </center>

</BorderPane>