                        <Label text="Qty: 10" style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                </GridPane>

                <Separator/>

                <!-- ================================================= -->
                <!-- ADD-ON ITEMS -->
                <!-- ================================================= -->

                <Label
                        text="ADD-ONS"

                        style="
                            -fx-font-size:20;
                            -fx-font-weight:bold;
                            -fx-text-fill:white;
                        "/>

                <HBox
                        spacing="35"
                        alignment="CENTER">

                    <VBox
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="80"
                                fitHeight="80"
                                preserveRatio="true"/>

                        <Label
                                text="Add-on 1"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱15.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Button
                                text="Add"
                                prefWidth="90"/>

                    </VBox>

                    <VBox
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="80"
                                fitHeight="80"
                                preserveRatio="true"/>

                        <Label
                                text="Add-on 2"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱20.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Button
                                text="Add"
                                prefWidth="90"/>

                    </VBox>

                    <VBox
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="80"
                                fitHeight="80"
                                preserveRatio="true"/>

                        <Label
                                text="Add-on 3"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱25.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Button
                                text="Add"
                                prefWidth="90"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- ================================================= -->
            <!-- PAYMENT / CONTROL PANEL -->
            <!-- ================================================= -->

            <VBox

                    prefWidth="280"
                    spacing="18"

                    style="
                        -fx-background-color:#F6F6F6;
                        -fx-background-radius:18;
                        -fx-border-color:#BBBBBB;
                        -fx-border-radius:18;
                        -fx-border-width:2;
                        -fx-padding:20;
                    ">

                <Label

                        text="CURRENT BALANCE"

                        style="
                            -fx-font-size:16;
                            -fx-font-weight:bold;
                        "/>

                <!-- Green 7-segment display -->

                <StackPane

                        prefHeight="70"

                        style="
                            -fx-background-color:#325C39;
                            -fx-background-radius:8;
                            -fx-border-color:#222222;
                            -fx-border-width:3;
                        ">

                    <Label

                            text="₱0000.00"

                            style="
                                -fx-font-family:'Consolas';
                                -fx-font-size:32;
                                -fx-font-weight:bold;
                                -fx-text-fill:#9CFF7A;
                            "/>

                </StackPane>

                <Separator/>

                <Label

                        text="INSERT CASH"

                        style="
                            -fx-font-size:18;
                            -fx-font-weight:bold;
                        "/>

                <GridPane
                        hgap="10"
                        vgap="10"
                        alignment="CENTER">

                    <Button
                            text="₱1"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱5"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱10"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱20"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱50"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱100"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱200"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="0"/>

                    <Button
                            text="₱500"
                            prefWidth="95"
                            prefHeight="45"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"/>

                    <Button
                            text="₱1000"

                            prefHeight="45"
                            maxWidth="Infinity"

                            GridPane.rowIndex="4"
                            GridPane.columnIndex="0"
                            GridPane.columnSpan="2"/>

                </GridPane>

                <Separator/>

                <Button

                        text="GET CHANGE"

                        prefHeight="55"
                        maxWidth="Infinity"

                        style="
                            -fx-background-color:#C0392B;
                            -fx-text-fill:white;
                            -fx-font-size:18;
                            -fx-font-weight:bold;
                        "/>

            </VBox>

