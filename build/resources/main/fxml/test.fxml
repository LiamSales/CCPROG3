<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ui.BlankPageController"

        style="-fx-background-color:#D9D9D9;">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"

                style="
                    -fx-background-color:#ECECEC;
                    -fx-padding:20;
                ">

            <Button
                    text="Back"
                    prefWidth="90"
                    onAction="#backToMainPage"/>

            <Label

                    text="Test Machine"

                    style="
                        -fx-font-size:30;
                        -fx-font-weight:bold;
                    "/>

        </HBox>

    </top>

    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <HBox
                alignment="TOP_CENTER"
                spacing="35"

                style="-fx-padding:25;">

            <!-- ================================================= -->
            <!-- MACHINE BODY -->
            <!-- ================================================= -->

            <VBox

                    prefWidth="760"
                    spacing="25"

                    style="
                        -fx-background-color:#2A2A2A;
                        -fx-background-radius:20;
                        -fx-border-color:#666666;
                        -fx-border-width:5;
                        -fx-border-radius:20;
                        -fx-padding:25;
                    ">

                <Label

                        text="ITEMS"

                        style="
                            -fx-font-size:22;
                            -fx-font-weight:bold;
                            -fx-text-fill:white;
                        "/>

                <!-- ================= FIRST ROW ================= -->

                <GridPane
                        hgap="25"
                        vgap="25">

                    <!-- ================= A1 ================= -->

                    <VBox
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="0"

                            alignment="CENTER"
                            spacing="8"

                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="A1"

                                style="
                                    -fx-text-fill:white;
                                    -fx-font-size:18;
                                    -fx-font-weight:bold;
                                "/>

                        <Label
                                text="Item Name"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱50.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Label
                                text="Qty: 10"
                                style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <!-- ================= A2 ================= -->

                    <VBox
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"

                            alignment="CENTER"
                            spacing="8"

                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="A2"

                                style="
                                    -fx-text-fill:white;
                                    -fx-font-size:18;
                                    -fx-font-weight:bold;
                                "/>

                        <Label
                                text="Item Name"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱50.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Label
                                text="Qty: 10"
                                style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <!-- ================= A3 ================= -->

                    <VBox
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2"

                            alignment="CENTER"
                            spacing="8"

                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="A3"

                                style="
                                    -fx-text-fill:white;
                                    -fx-font-size:18;
                                    -fx-font-weight:bold;
                                "/>

                        <Label
                                text="Item Name"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱50.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Label
                                text="Qty: 10"
                                style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <!-- ================= A4 ================= -->

                    <VBox
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="3"

                            alignment="CENTER"
                            spacing="8"

                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="A4"

                                style="
                                    -fx-text-fill:white;
                                    -fx-font-size:18;
                                    -fx-font-weight:bold;
                                "/>

                        <Label
                                text="Item Name"
                                style="-fx-text-fill:white;"/>

                        <Label
                                text="₱50.00"
                                style="-fx-text-fill:#FFE17B;"/>

                        <Label
                                text="Qty: 10"
                                style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <!-- ================= SECOND ROW ================= -->

                    <VBox
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="0"
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="B1"
                                style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;"/>

                        <Label text="Item Name" style="-fx-text-fill:white;"/>
                        <Label text="₱50.00" style="-fx-text-fill:#FFE17B;"/>
                        <Label text="Qty: 10" style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <VBox
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="B2"
                                style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;"/>

                        <Label text="Item Name" style="-fx-text-fill:white;"/>
                        <Label text="₱50.00" style="-fx-text-fill:#FFE17B;"/>
                        <Label text="Qty: 10" style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <VBox
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2"
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="B3"
                                style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;"/>

                        <Label text="Item Name" style="-fx-text-fill:white;"/>
                        <Label text="₱50.00" style="-fx-text-fill:#FFE17B;"/>
                        <Label text="Qty: 10" style="-fx-text-fill:#CCCCCC;"/>

                        <Button
                                text="Purchase"
                                prefWidth="110"/>

                    </VBox>

                    <VBox
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="3"
                            alignment="CENTER"
                            spacing="8"
                            prefWidth="150">

                        <ImageView
                                fitWidth="90"
                                fitHeight="110"
                                preserveRatio="true"/>

                        <Label
                                text="B4"
                                style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;"/>

