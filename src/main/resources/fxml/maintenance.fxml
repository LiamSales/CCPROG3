<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"

        fx:controller="ui.MaintenanceController"

        spacing="20"
        alignment="TOP_CENTER"

        style="
            -fx-background-color: #F0F0F0;
            -fx-padding: 30;
        ">

    <HBox spacing="20" alignment="CENTER_LEFT">

        <Button
                text="Back"
                onAction="#backToMainPage"/>

        <Label
                text="Machine Maintenance"

                style="
                    -fx-font-size: 30px;
                    -fx-font-weight: bold;
                "/>

    </HBox>

    <GridPane
            fx:id="slotGrid"

            hgap="15"
            vgap="15"

            alignment="CENTER"/>

    <Label
            text="Machine Maintenance"

            style="
                -fx-font-size:22px;
                -fx-font-weight:bold;
            "/>

    <HBox
            spacing="15"
            alignment="CENTER">

        <Button
                text="Replenish Cash"
                onAction="#replenishCash"/>

        <Button
                text="Collect Balance"
                onAction="#collectBalance"/>

        <Button
                text="Display Summary"
                onAction="#displaySummary"/>

    </HBox>

    <Button
            text="Remove Machine"

            style="
                -fx-background-color:#D9534F;
                -fx-text-fill:white;
            "

            onAction="#removeMachine"/>

</VBox>