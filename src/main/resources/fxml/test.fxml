<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ui.TestController"

        style="
            -fx-background-color:#F4F4F4;
        ">

    <!-- ========================= -->
    <!-- Top -->
    <!-- ========================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15"
                style="-fx-padding:20;">

            <Button
                    text="Back"
                    onAction="#backToMainPage"/>

            <Label
                    text="Test Vending Machine"
                    style="
                        -fx-font-size:28px;
                        -fx-font-weight:bold;
                    "/>

        </HBox>

    </top>

    <!-- ========================= -->
    <!-- Center -->
    <!-- ========================= -->

    <center>

        <HBox spacing="25">

            <padding>
                <Insets
                        top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- ===================================== -->
            <!-- LEFT SIDE -->
            <!-- ===================================== -->

            <VBox
                    spacing="20"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="Items"
                        style="
                            -fx-font-size:22px;
                            -fx-font-weight:bold;
                        "/>

                <ScrollPane
                        fitToWidth="true"
                        prefHeight="450">

                    <content>

                        <GridPane
                                fx:id="slotGrid"

                                hgap="15"
                                vgap="15"/>

                    </content>

                </ScrollPane>

                <Label
                        fx:id="addOnTitle"
                        text="Add-ons"
                        style="
                            -fx-font-size:22px;
                            -fx-font-weight:bold;
                        "/>

                <ScrollPane
                        fx:id="addOnScroll"
                        fitToHeight="true"
                        prefHeight="180">

                    <content>

                        <HBox
                                fx:id="addOnContainer"
                                spacing="15"
                                style="-fx-padding:10;"/>

                    </content>

                </ScrollPane>

            </VBox>

            <!-- ===================================== -->
            <!-- RIGHT SIDE -->
            <!-- ===================================== -->

            <VBox
                    spacing="15"
                    prefWidth="250"
                    alignment="TOP_CENTER">

                <Label
                        text="Balance"
                        style="
                            -fx-font-size:18px;
                            -fx-font-weight:bold;
                        "/>

                <Label
                        fx:id="balanceLabel"
                        text="₱0.00"
                        style="
                            -fx-font-size:28px;
                            -fx-font-weight:bold;
                        "/>

                <Label
                        fx:id="displayLabel"
                        text="Welcome"/>

                <Label
                        text="Insert Cash"
                        style="-fx-font-weight:bold;"/>

                <GridPane
                        hgap="8"
                        vgap="8">

                    <Button text="₱1000" onAction="#addCash" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button text="₱500" onAction="#addCash" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Button text="₱200" onAction="#addCash" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button text="₱100" onAction="#addCash" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Button text="₱50" onAction="#addCash" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Button text="₱20" onAction="#addCash" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Button text="₱10" onAction="#addCash" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Button text="₱5" onAction="#addCash" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Button text="₱1" onAction="#addCash" GridPane.columnIndex="0" GridPane.rowIndex="4"/>

                </GridPane>

                <Button
                        text="Get Change"
                        maxWidth="Infinity"
                        onAction="#getChange"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>