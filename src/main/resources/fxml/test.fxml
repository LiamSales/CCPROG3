<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane

        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml"

        fx:controller="ui.BlankPageController"

        style="-fx-background-color:#F0F0F0;">

    <top>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding:20;">

            <Button
                    text="Back"
                    onAction="#backToMainPage"
                    prefWidth="100"/>

            <Label
                    text="Test Machine"

                    style="
                        -fx-font-size:30px;
                        -fx-font-weight:bold;
                    "/>

        </HBox>

    </top>

    <center>

        <HBox
                alignment="CENTER"
                spacing="25">

            <!-- Machine Body -->

            <VBox

                    alignment="TOP_CENTER"
                    spacing="20"

                    prefWidth="650"
                    prefHeight="850"

                    style="
                        -fx-background-color:#222222;
                        -fx-background-radius:20;
                        -fx-padding:25;
                    ">

                <Label

                        text="VENDING MACHINE"

                        style="
                            -fx-text-fill:white;
                            -fx-font-size:24;
                            -fx-font-weight:bold;
                        "/>

                <!-- Slots -->

                <GridPane

                        hgap="15"
                        vgap="15">

                    <!-- Row 1 -->

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="A1" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="A2" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="2" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="A3" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="0" GridPane.columnIndex="3" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="A4" style="-fx-text-fill:white;"/>
                    </VBox>

                    <!-- Row 2 -->

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="B1" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="B2" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="2" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="B3" style="-fx-text-fill:white;"/>
                    </VBox>

                    <VBox GridPane.rowIndex="1" GridPane.columnIndex="3" alignment="CENTER" spacing="5">
                        <StackPane prefWidth="110" prefHeight="90" style="-fx-background-color:#CFCFCF;"/>
                        <Label text="B4" style="-fx-text-fill:white;"/>
                    </VBox>

                </GridPane>

            </VBox>

            <!-- Payment Panel -->

            <VBox

                    alignment="TOP_CENTER"
                    spacing="18"

                    prefWidth="220"
                    prefHeight="850"

                    style="
                        -fx-background-color:#303030;
                        -fx-background-radius:20;
                        -fx-padding:20;
                    ">

                <Label

                        text="PAYMENT"

                        style="
                            -fx-text-fill:white;
                            -fx-font-size:20;
                            -fx-font-weight:bold;
                        "/>

                <StackPane

                        prefWidth="160"
                        prefHeight="110"

                        style="
                            -fx-background-color:#666666;
                            -fx-background-radius:10;
                        ">

                    <Label text="DISPLAY"/>

                </StackPane>

                <GridPane

                        hgap="10"
                        vgap="10">

                    <Button text="1" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="2" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button text="3" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                    <Button text="4" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button text="5" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button text="6" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                    <Button text="7" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Button text="8" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Button text="9" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                    <Button text="*" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Button text="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Button text="#" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

                </GridPane>

                <StackPane

                        prefWidth="160"
                        prefHeight="45"

                        style="
                            -fx-background-color:#B0B0B0;
                            -fx-background-radius:8;
                        ">

                    <Label text="BILL ACCEPTOR"/>

                </StackPane>

                <StackPane

                        prefWidth="160"
                        prefHeight="45"

                        style="
                            -fx-background-color:#808080;
                            -fx-background-radius:8;
                        ">

                    <Label text="COIN SLOT"/>

                </StackPane>

                <VBox VBox.vgrow="ALWAYS"/>

                <Button

                        text="PURCHASE"

                        prefWidth="160"
                        prefHeight="50"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>